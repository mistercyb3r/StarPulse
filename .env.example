# Copy to `.env` (and export the variables, or pass them via Docker/systemd)
# to override values from the generated config.toml. Any value left unset
# falls back to the config file, and any value not in the config file falls
# back to the built-in default.

# Directory where StarPulse stores its config.toml, SQLite database, and logs.
# STARPULSE_DATA_DIR=./data

# Path to an explicit config file (overrides STARPULSE_DATA_DIR/config.toml).
# STARPULSE_CONFIG_FILE=./data/config.toml

# Server
# STARPULSE_HOST=0.0.0.0
# STARPULSE_PORT=8000

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
# STARPULSE_LOG_LEVEL=INFO
# STARPULSE_LOG_FILE=./data/starpulse.log

# Database (path is relative to STARPULSE_DATA_DIR unless absolute)
# STARPULSE_DB_PATH=starpulse.db

# Starlink dish connection + polling
# STARPULSE_DISH_HOST=192.168.100.1
# STARPULSE_DISH_PORT=9200
# STARPULSE_POLL_INTERVAL_SECONDS=5.0

# --- Docker Compose only ---
# Host port the backend container's API/docs are published on.
# STARPULSE_PORT=8000
# Host port the frontend container (dashboard) is published on.
# STARPULSE_WEB_PORT=8080
