# Copy to .env.local to override.
#
# Base URL of the StarPulse backend API. Leave unset (or empty) to use
# relative paths, which works when the dev server proxy (vite.config.ts)
# or a reverse proxy forwards /api to the backend for you. Set it
# explicitly if the frontend is served from a different origin than the
# backend, e.g.:
# VITE_API_BASE_URL=http://raspberrypi.local:8000
